# Supabase — projeto Fernandes Advocacia (yaqrfftsnqqecoaqssij)
NEXT_PUBLIC_SUPABASE_URL=https://yaqrfftsnqqecoaqssij.supabase.co
# Chave publicável (segura para o browser; RLS protege os dados)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Allowlist de login (separar por vírgula). Rodolfo entra aqui depois.
ALLOWED_EMAILS=danielsfernandes8@gmail.com
# Mapa e-mail -> sócio (atribuição de peças/tarefas). EMAIL_DANIEL tem default;
# preencha EMAIL_RODOLFO quando o e-mail do Rodolfo for definido.
EMAIL_DANIEL=danielsfernandes8@gmail.com
EMAIL_RODOLFO=
# URL pública do site (usada no redirect do magic link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Calendar (opcional; Fase 2) ---
# Service account com acesso de escrita ao calendário do escritório.
# Sem estas variáveis, a validação grava só no banco (degradação segura).
GOOGLE_CLIENT_EMAIL=conta-servico@projeto.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID=prazos@group.calendar.google.com

# --- Google Drive — upload de documentos (opcional; degradação segura) ---
# O Drive do escritório é uma conta Gmail comum: uma service account NÃO tem cota
# para ser dona de arquivos nela, então o upload usa OAuth do próprio Daniel
# (refresh token com escopo https://www.googleapis.com/auth/drive). Sem estas
# variáveis, o frontend cai no registro manual por id do Drive (não derruba nada).
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=xxxx
GOOGLE_OAUTH_REFRESH_TOKEN=xxxx
# Pasta Sistema/Clientes (default já aponta para a pasta atual do escritório).
GOOGLE_DRIVE_CLIENTES_FOLDER_ID=1lZ1kkEgK6SeP9DDlY8kHVbghZlyMhzOc
