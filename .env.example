# Supabase — projeto Fernandes Advocacia (yaqrfftsnqqecoaqssij)
NEXT_PUBLIC_SUPABASE_URL=https://yaqrfftsnqqecoaqssij.supabase.co
# Chave publicável (segura para o browser; RLS protege os dados)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Allowlist de login (separar por vírgula). Rodolfo entra aqui depois.
ALLOWED_EMAILS=danielsfernandes8@gmail.com
# Mapa e-mail -> sócio (atribuição de peças/tarefas). EMAIL_DANIEL tem default;
# preencha EMAIL_RODOLFO quando o e-mail do Rodolfo for definido.
EMAIL_DANIEL=danielsfernandes8@gmail.com
EMAIL_RODOLFO=
# URL pública do site (usada no redirect do magic link)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Calendar (opcional; Fase 2) ---
